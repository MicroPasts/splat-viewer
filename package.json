{
  "name": "@micropasts/splat-viewer",
  "version": "0.1.0",
  "description": "Standalone Three.js + Spark Gaussian splat viewer for React and cultural heritage workflows",
  "type": "module",
  "main": "./dist/splat-viewer.umd.cjs",
  "module": "./dist/splat-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/splat-viewer.js",
      "require": "./dist/splat-viewer.umd.cjs"
    },
    "./styles.css": "./dist/splat-viewer.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docs": "vite build --mode docs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "three": "^0.180.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.2.0"
  },
  "keywords": [
    "gaussian-splatting",
    "3d-viewer",
    "threejs",
    "sparkjs",
    "react",
    "cultural-heritage",
    "paradata"
  ],
  "author": "Daniel Pett",
  "repository": {
    "type": "git",
    "url": "https://github.com/micropasts/splat-viewer.git"
  },
  "license": "MIT",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
